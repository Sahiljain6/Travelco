# Copy these keys into your host's environment settings. Never commit a real .env file.
NODE_ENV=production
PORT=5000
MONGO_URI=
JWT=
# Replace this placeholder with the deployed CloudFront viewer URL before use.
FRONTEND_URL=https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
CORS_ORIGINS=https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
# Keep at 0 until the CloudFront -> nginx proxy chain and origin restrictions are verified.
TRUST_PROXY_HOPS=0
# Same-origin CloudFront frontend/API deployments should use lax by default.
AUTH_COOKIE_SAME_SITE=lax
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Travelco <no-reply@example.com>

# Cloudinary (server-side image uploads; NEVER expose CLOUDINARY_API_SECRET in React)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weather lookup (OpenWeather; keep this API key server-side)
OPENWEATHER_API_KEY=

# MapTiler is browser-visible: set REACT_APP_MAPTILER_API_KEY in the frontend build environment and restrict its allowed origins.

# Flight search provider (keep this secret on the backend only)
SKYSCANNER_RAPIDAPI_KEY=
# Optional vehicle driver fee in the same currency units as the vehicle listing
DRIVER_DAILY_FEE=
