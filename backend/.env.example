# Copy these keys into your host's environment settings. Never commit a real .env file.
NODE_ENV=production
PORT=5000
MONGO_URI=
JWT=
FRONTEND_URL=https://travelxco.netlify.app
CORS_ORIGINS=https://travelxco.netlify.app
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Travelco <no-reply@example.com>

# Cloudinary (server-side image uploads; NEVER expose CLOUDINARY_API_SECRET in React)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weather lookup (OpenWeather; keep this API key server-side)
OPENWEATHER_API_KEY=

# MapTiler is browser-visible: set REACT_APP_MAPTILER_API_KEY in Netlify and restrict its allowed origins.
