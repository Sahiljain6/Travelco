# Copy these keys into your host's environment settings. Never commit a real .env file.
NODE_ENV=production
PORT=5000
MONGO_URI=
JWT=
# Current CloudFront URL documented in the AWS deployment report; verify before copying.
FRONTEND_URL=https://dp0upmp8cla6l.cloudfront.net
CORS_ORIGINS=https://dp0upmp8cla6l.cloudfront.net
# Preserve existing Express behavior; adjust only after the live proxy chain is verified.
TRUST_PROXY_HOPS=1
# Preserve the current production cookie behavior. Change only after staging verification.
AUTH_COOKIE_SAME_SITE=none
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Travelco <no-reply@example.com>

# Cloudinary (server-side image uploads; NEVER expose CLOUDINARY_API_SECRET in React)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weather lookup (OpenWeather; keep this API key server-side)
OPENWEATHER_API_KEY=

# MapTiler is browser-visible: set REACT_APP_MAPTILER_API_KEY in the frontend build environment and restrict its allowed origins.

# Flight search provider (keep this secret on the backend only)
SKYSCANNER_RAPIDAPI_KEY=
# Optional vehicle driver fee in the same currency units as the vehicle listing
DRIVER_DAILY_FEE=
